+@media (max-width: 900px) {
+    .centro-control-layout {
+        grid-template-columns: 1fr;
+    }
+}
+
+.centro-control-layout .mapa-tarjeta h3,
+.centro-control-layout .ranking-localidades h3 {
+    font-family: 'Rajdhani', sans-serif;
+    margin-top: 0;
+    font-size: 1rem;
+}
