+
+/* ---------- KPIs reutilizables (Centro de Control, Análisis Territorial) ---------- */
+
+.kpi-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+    gap: 0.85rem;
+    margin-bottom: 1rem;
+}
+
+.kpi-card {
+    background: var(--bg-panel);
+    border-radius: 10px;
+    padding: 1rem 1.1rem;
+    border: 1px solid var(--borde-sutil);
+    box-shadow: var(--sombra-panel);
+    display: flex;
+    flex-direction: column;
+    gap: 0.3rem;
+}
+
+.kpi-card-alto {
+    border-color: rgba(239, 68, 68, 0.45);
+}
+
+.kpi-valor {
+    font-family: 'Share Tech Mono', monospace;
+    font-size: 1.6rem;
+    line-height: 1.1;
+}
+
+.kpi-etiqueta {
+    font-size: 0.75rem;
+    opacity: 0.7;
+}
+
+/* ---------- Centro de Control Estratégico ---------- */
+
+.centro-control-layout {
+    display: grid;
+    grid-template-columns: 2fr 1fr;
+    gap: 1rem;
+    align-items: start;
+    margin-bottom: 1rem;
+}
